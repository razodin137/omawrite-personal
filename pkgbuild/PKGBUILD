pkgname=writecam
pkgver=0.1.0
pkgrel=3
pkgdesc='Dead-simple Markdown writing app with YAML front matter, built with Qt Quick'
arch=('x86_64')
url='https://github.com/razodin137/omawrite-personal'
license=('MIT')
install='writecam.install'
depends=('qt6-base' 'qt6-declarative' 'xdg-desktop-portal')
makedepends=('gcc' 'make' 'qt6-base' 'qt6-declarative')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  /usr/bin/install -Dm755 build/writecam "$pkgdir/usr/bin/writecam"
  /usr/bin/install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  /usr/bin/install -Dm644 fonts/OFL.txt "$pkgdir/usr/share/licenses/$pkgname/OFL.txt"
  /usr/bin/install -Dm644 "$startdir/writecam.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/writecam.svg"
  /usr/bin/install -Dm644 "$startdir/writecam.desktop" "$pkgdir/usr/share/applications/writecam.desktop"
}